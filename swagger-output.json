    "/api/menu/": {
      "get": {
        "tags": [
          "Menu"
        ],
        "summary": "Obtener y filtrar todos los Productos del Menu",
        "description": "Retorna la lista de productos permitiendo filtrar por nombre, minPrecio y/o maxPrecio",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Define el número límite máximo de productos a mostrar, por defecto es 10",
            "required": false,
            "type": "string"
          },
          {
            "name": "page",
            "in": "query",
            "description": "Define el número de página de productos filtrados a mostrar, por defecto es 1",
            "required": false,
            "type": "string"
          },
          {
            "name": "nombre",
            "in": "query",
            "description": "Filtro por nombre del producto",
            "required": false,
            "type": "string"
          },
          {
            "name": "minPrecio",
            "in": "query",
            "description": "Filtro para productos que sean mayores a minPrecio",
            "required": false,
            "type": "number"
          },
          {
            "name": "maxPrecio",
            "in": "query",
            "description": "Filtro para productos que sean menores a maxPrecio",
            "required": false,
            "type": "number"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          },
          "503": {
            "description": "Service Unavailable"
          }
        }
      },
      "post": {
        "tags": [
          "Menu"
        ],
        "summary": "Crear un producto nuevo para el Menu",
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Datos para el nuevo producto. Todos los datos son obligatorios.",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "nombre": {
                  "type": "string",
                  "example": "Ceviche"
                },
                "precio": {
                  "type": "number",
                  "example": 20
                },
                "descripcion": {
                  "type": "string",
                  "example": "Pescado A1 en trozos con citricos, especias y cebolla"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          },
          "503": {
            "description": "Service Unavailable"
          }
        }
      }
    },
